generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
  COORDINATOR

  @@map("user_role")
}

enum MemberType {
  INDIVIDUAL
  UNIT

  @@map("member_type")
}

enum WasteCategory {
  PLASTIC
  PAPER
  METAL
  GLASS
  OTHER

  @@map("waste_category")
}

enum WasteCondition {
  SORTED
  UNSORTED

  @@map("waste_condition")
}

enum DepositStatus {
  DRAFT
  VERIFIED
  REJECTED

  @@map("settlement_method")
}

enum TransactionStatus {
  DRAFT
  FINALIZED
  COMPLETED
  CANCELLED

  @@map("transaction_status")
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED

  @@map("withdrawal_status")
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  OPENING_BALANCE
  REVERSAL
  ADJUSTMENT

  @@map("ledger_entry_type")
}

enum TransactionStatus {
  DRAFT
  FINALIZED
  COMPLETED
  CANCELLED
  VOIDED

  @@map("transaction_status")
}

enum TransactionSource {
  DIRECT_ENTRY
  IMPORT

  @@map("transaction_source")
}

enum PayoutMethod {
  DIRECT_CASH
  SAVINGS

  @@map("payout_method")
}

enum FinancialLedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  REVERSAL
  ADJUSTMENT

  @@map("financial_ledger_entry_type")
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED

  @@map("withdrawal_status")
}

model Organization {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @db.VarChar(160)
  address               String?  @db.VarChar(500)
  contactPhone          String?  @map("contact_phone") @db.VarChar(32)
  activityThresholdDays Int      @default(90) @map("activity_threshold_days")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profiles            Profile[]
  members             Member[]
  wasteTypes          WasteType[]
  transactions        Transaction[]
  ledgerEntries       LedgerEntry[]
  withdrawals         Withdrawal[]
  auditLogs           AuditLog[]
  memberRelationships MemberRelationship[]
  transactions        Transaction[]
  financialLedger     FinancialLedger[]
  wastePriceVersions  WastePriceVersion[]
  withdrawals         Withdrawal[]

  @@map("organizations")
}

model Profile {
  /// Uses the same UUID as auth.users.id. The cross-schema FK is added by SQL migration.
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fullName       String   @map("full_name") @db.VarChar(160)
  role           UserRole
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdDeposits        Deposit[]           @relation("DepositCreatedBy")
  verifiedDeposits       Deposit[]           @relation("DepositVerifiedBy")
  createdRedemptions     Redemption[]        @relation("RedemptionCreatedBy")
  cancelledRedemptions   Redemption[]        @relation("RedemptionCancelledBy")
  auditLogs              AuditLog[]          @relation("AuditActor")
  createdTransactions    Transaction[]       @relation("TransactionCreatedBy")
  finalizedTransactions  Transaction[]       @relation("TransactionFinalizedBy")
  completedTransactions  Transaction[]       @relation("TransactionCompletedBy")
  financialLedgerEntries FinancialLedger[]   @relation("FinancialLedgerCreatedBy")
  createdWastePrices     WastePriceVersion[] @relation("WastePriceCreatedBy")
  requestedWithdrawals   Withdrawal[]        @relation("WithdrawalRequestedBy")
  approvedWithdrawals    Withdrawal[]        @relation("WithdrawalApprovedBy")
  paidWithdrawals        Withdrawal[]        @relation("WithdrawalPaidBy")

  @@index([organizationId, isActive])
  @@map("profiles")
}

model Member {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  memberNumber   String     @map("member_number") @db.VarChar(32)
  fullName       String     @map("full_name") @db.VarChar(160)
  type           MemberType @default(INDIVIDUAL)
  rt             String?    @db.VarChar(16)
  phone          String?    @db.VarChar(32)
  picName        String?    @map("pic_name") @db.VarChar(160)
  picPhone       String?    @map("pic_phone") @db.VarChar(32)
  publicToken    String     @unique @default(uuid()) @map("public_token") @db.Uuid
  isActive       Boolean    @default(true) @map("is_active")
  lastActivityAt DateTime?  @map("last_activity_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transactions            Transaction[]
  ledgerEntries           LedgerEntry[]
  withdrawals             Withdrawal[]
  individualRelationships MemberRelationship[] @relation("RelationshipIndividual")
  unitRelationships       MemberRelationship[] @relation("RelationshipUnit")
  transactions            Transaction[]
  financialLedger         FinancialLedger[]
  withdrawals             Withdrawal[]

  @@unique([organizationId, memberNumber])
  @@index([organizationId, type, isActive, fullName])
  @@index([organizationId, lastActivityAt])
  @@map("members")
}

model MemberRelationship {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  individualId   String   @map("individual_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  individual   Member       @relation("RelationshipIndividual", fields: [individualId], references: [id], onDelete: Restrict)
  unit         Member       @relation("RelationshipUnit", fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([organizationId, individualId, unitId])
  @@index([organizationId, unitId, isActive])
  @@index([organizationId, individualId, isActive])
  @@map("member_relationships")
}

model WasteType {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String        @db.VarChar(120)
  category       WasteCategory
  unit           String        @default("kg") @db.VarChar(16)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  impactFactors    ImpactFactor[]
  depositItems     DepositItem[]
  transactionItems TransactionItem[]
  priceVersions    WastePriceVersion[]

  @@unique([organizationId, name])
  @@index([organizationId, category, isActive])
  @@map("waste_types")
}

// Versioned pricing (PRD v3.0 rupiah pivot): a price change never mutates old
// rows, it closes the current open-ended version (effectiveUntil) and opens a
// new one. priceScheme is a free-form string, not an enum, because whether
// DIRECT_CASH and SAVINGS actually need different prices is still an open
// field-research question (see root README "Validasi Sebelum Feature
// Freeze"). Default "STANDARD" means "one price regardless of method" until
// that's confirmed.
model WastePriceVersion {
  id             String    @id @default(uuid()) @db.Uuid
  wasteTypeId    String    @map("waste_type_id") @db.Uuid
  priceScheme    String    @default("STANDARD") @map("price_scheme") @db.VarChar(40)
  pricePerKg     Decimal   @map("price_per_kg") @db.Decimal(14, 2)
  effectiveFrom  DateTime  @default(now()) @map("effective_from") @db.Timestamptz(3)
  effectiveUntil DateTime? @map("effective_until") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  wasteType WasteType @relation(fields: [wasteTypeId], references: [id], onDelete: Restrict)

  @@index([wasteTypeId, priceScheme, effectiveFrom])
  @@map("waste_price_versions")
}

model ImpactFactor {
  id               String   @id @default(uuid()) @db.Uuid
  wasteTypeId      String   @map("waste_type_id") @db.Uuid
  factorValue      Decimal  @map("factor_value") @db.Decimal(18, 6)
  unit             String   @db.VarChar(80)
  sourceUrl        String   @map("source_url") @db.Text
  sourceAccessedAt DateTime @map("source_accessed_at") @db.Date
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  wasteType WasteType @relation(fields: [wasteTypeId], references: [id], onDelete: Restrict)

  @@index([wasteTypeId, isActive])
  @@map("impact_factors")
}

model WastePriceVersion {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  wasteTypeId    String         @map("waste_type_id") @db.Uuid
  pricePerKg     Decimal        @map("price_per_kg") @db.Decimal(16, 2)
  condition      WasteCondition
  effectiveFrom  DateTime       @map("effective_from") @db.Timestamptz(3)
  effectiveUntil DateTime?      @map("effective_until") @db.Timestamptz(3)
  createdBy      String?        @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  wasteType    WasteType    @relation(fields: [wasteTypeId], references: [id], onDelete: Restrict)
  creator      Profile?     @relation("WastePriceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([organizationId, wasteTypeId, condition, effectiveFrom])
  @@map("waste_price_versions")
}

model Deposit {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  memberId        String        @map("member_id") @db.Uuid
  status          DepositStatus @default(DRAFT)
  receiptToken    String        @unique @default(uuid()) @map("receipt_token") @db.Uuid
  clientUuid      String        @map("client_uuid") @db.Uuid
  createdBy       String        @map("created_by") @db.Uuid
  verifiedBy      String?       @map("verified_by") @db.Uuid
  verifiedAt      DateTime?     @map("verified_at") @db.Timestamptz(3)
  rejectionReason String?       @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  creator      Profile       @relation("DepositCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  verifier     Profile?      @relation("DepositVerifiedBy", fields: [verifiedBy], references: [id], onDelete: Restrict)
  items        DepositItem[]

  @@unique([organizationId, clientUuid])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, memberId, createdAt])
  @@map("transactions")
}

model TransactionItem {
  id                 String  @id @default(uuid()) @db.Uuid
  transactionId      String  @map("transaction_id") @db.Uuid
  wasteTypeId        String  @map("waste_type_id") @db.Uuid
  weightKg           Decimal @map("weight_kg") @db.Decimal(12, 3)
  pricePerKgSnapshot Decimal @map("price_per_kg_snapshot") @db.Decimal(14, 2)
  subtotalRupiah     Decimal @map("subtotal_rupiah") @db.Decimal(16, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  wasteType   WasteType   @relation(fields: [wasteTypeId], references: [id], onDelete: Restrict)

  @@unique([transactionId, wasteTypeId])
  @@index([wasteTypeId])
  @@map("transaction_items")
}

model LedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  memberId       String          @map("member_id") @db.Uuid
  entryType      LedgerEntryType @map("entry_type")
  amountRupiah   Decimal         @map("amount_rupiah") @db.Decimal(16, 2)
  sourceId       String          @map("source_id") @db.Uuid
  reversalOfId   String?         @unique @map("reversal_of_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  reversalOf   LedgerEntry?  @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy   LedgerEntry[] @relation("LedgerReversal")

  @@unique([organizationId, entryType, sourceId])
  @@index([organizationId, memberId, createdAt])
  @@map("ledger_entries")
}

// PRD v3.0: replaces the old immediate-debit Redemption. Withdrawals use a
// separate REQUESTED -> APPROVED -> PAID flow (or REJECTED); the ledger debit
// only happens at PAID, with the balance re-checked inside that same DB
// transaction - see root README "Model Ledger" and "Aturan Bisnis Kritis".
model Withdrawal {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  memberId        String           @map("member_id") @db.Uuid
  amountRupiah    Decimal          @map("amount_rupiah") @db.Decimal(16, 2)
  status          WithdrawalStatus @default(REQUESTED)
  notes           String?          @db.VarChar(500)
  proofPath       String?          @map("proof_path") @db.Text
  createdBy       String           @map("created_by") @db.Uuid
  approvedBy      String?          @map("approved_by") @db.Uuid
  approvedAt      DateTime?        @map("approved_at") @db.Timestamptz(3)
  paidBy          String?          @map("paid_by") @db.Uuid
  paidAt          DateTime?        @map("paid_at") @db.Timestamptz(3)
  rejectedBy      String?          @map("rejected_by") @db.Uuid
  rejectedAt      DateTime?        @map("rejected_at") @db.Timestamptz(3)
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  creator      Profile      @relation("WithdrawalCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approver     Profile?     @relation("WithdrawalApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  payer        Profile?     @relation("WithdrawalPaidBy", fields: [paidBy], references: [id], onDelete: Restrict)
  rejecter     Profile?     @relation("WithdrawalRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, memberId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("withdrawals")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  action         String   @db.VarChar(120)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String   @map("entity_id") @db.Uuid
  reason         String?  @db.VarChar(500)
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        Profile      @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model Transaction {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  memberId           String            @map("member_id") @db.Uuid
  status             TransactionStatus @default(DRAFT)
  source             TransactionSource @default(DIRECT_ENTRY)
  payoutMethod       PayoutMethod?     @map("payout_method")
  clientRequestId    String            @map("client_request_id") @db.Uuid
  receiptToken       String            @unique @default(uuid()) @map("receipt_token") @db.Uuid
  receiptNumber      String?           @unique @map("receipt_number") @db.VarChar(64)
  memberNameSnapshot String?           @map("member_name_snapshot") @db.VarChar(160)
  notes              String?           @db.VarChar(500)
  totalWeightKg      Decimal           @default(0) @map("total_weight_kg") @db.Decimal(14, 3)
  totalAmount        Decimal           @default(0) @map("total_amount") @db.Decimal(18, 2)
  createdBy          String            @map("created_by") @db.Uuid
  finalizedBy        String?           @map("finalized_by") @db.Uuid
  finalizedAt        DateTime?         @map("finalized_at") @db.Timestamptz(3)
  completedBy        String?           @map("completed_by") @db.Uuid
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(500)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member        Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  creator       Profile           @relation("TransactionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  finalizer     Profile?          @relation("TransactionFinalizedBy", fields: [finalizedBy], references: [id], onDelete: Restrict)
  completer     Profile?          @relation("TransactionCompletedBy", fields: [completedBy], references: [id], onDelete: Restrict)
  items         TransactionItem[]
  ledgerEntries FinancialLedger[]

  @@unique([organizationId, clientRequestId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, memberId, createdAt])
  @@map("transactions")
}

model TransactionItem {
  id                    String         @id @default(uuid()) @db.Uuid
  transactionId         String         @map("transaction_id") @db.Uuid
  wasteTypeId           String         @map("waste_type_id") @db.Uuid
  wasteTypeNameSnapshot String         @map("waste_type_name_snapshot") @db.VarChar(120)
  condition             WasteCondition
  weightKg              Decimal        @map("weight_kg") @db.Decimal(12, 3)
  pricePerKgSnapshot    Decimal        @map("price_per_kg_snapshot") @db.Decimal(16, 2)
  subtotalAmount        Decimal        @map("subtotal_amount") @db.Decimal(18, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  wasteType   WasteType   @relation(fields: [wasteTypeId], references: [id], onDelete: Restrict)

  @@unique([transactionId, wasteTypeId, condition])
  @@index([wasteTypeId])
  @@map("transaction_items")
}

model FinancialLedger {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  memberId       String                   @map("member_id") @db.Uuid
  transactionId  String?                  @map("transaction_id") @db.Uuid
  withdrawalId   String?                  @unique @map("withdrawal_id") @db.Uuid
  entryType      FinancialLedgerEntryType @map("entry_type")
  amount         Decimal                  @db.Decimal(18, 2)
  referenceKey   String                   @map("reference_key") @db.VarChar(160)
  notes          String?                  @db.VarChar(500)
  createdBy      String                   @map("created_by") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  transaction  Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  withdrawal   Withdrawal?  @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  creator      Profile      @relation("FinancialLedgerCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, referenceKey])
  @@index([organizationId, memberId, createdAt])
  @@index([transactionId])
  @@map("financial_ledger")
}

model Withdrawal {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  memberId        String           @map("member_id") @db.Uuid
  status          WithdrawalStatus @default(REQUESTED)
  amount          Decimal          @db.Decimal(18, 2)
  notes           String?          @db.VarChar(500)
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)
  requestedBy     String           @map("requested_by") @db.Uuid
  approvedBy      String?          @map("approved_by") @db.Uuid
  paidBy          String?          @map("paid_by") @db.Uuid
  approvedAt      DateTime?        @map("approved_at") @db.Timestamptz(3)
  paidAt          DateTime?        @map("paid_at") @db.Timestamptz(3)
  rejectedAt      DateTime?        @map("rejected_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  requester    Profile           @relation("WithdrawalRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  approver     Profile?          @relation("WithdrawalApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  payer        Profile?          @relation("WithdrawalPaidBy", fields: [paidBy], references: [id], onDelete: Restrict)
  ledgerEntry  FinancialLedger?

  @@index([organizationId, status, createdAt])
  @@index([organizationId, memberId, createdAt])
  @@map("withdrawals")
}
